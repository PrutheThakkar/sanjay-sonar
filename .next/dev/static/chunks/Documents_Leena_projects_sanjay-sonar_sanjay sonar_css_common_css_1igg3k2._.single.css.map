/* Local font imports */
@font-face {
  font-family: "Agrandir GrandHeavy";
  src: url("/fonts/Agrandir-GrandHeavy.otf") format("opentype");
  font-weight: 900;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Agrandir GrandLight";
  src: url("/fonts/Agrandir-GrandLight.otf") format("opentype");
  font-weight: 300;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Agrandir Narrow";
  src: url("/fonts/Agrandir-Narrow.otf") format("opentype");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Agrandir Regular";
  src: url("/fonts/Agrandir-Regular.otf") format("opentype");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Agrandir TextBold";
  src: url("/fonts/Agrandir-TextBold.otf") format("opentype");
  font-weight: 700;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Agrandir Thin Italic";
  src: url("/fonts/Agrandir-ThinItalic.otf") format("opentype");
  font-weight: 200;
  font-style: italic;
  font-display: swap;
}
@font-face {
  font-family: "Agrandir Tight";
  src: url("/fonts/Agrandir-Tight.otf") format("opentype");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Agrandir WideBlack Italic";
  src: url("/fonts/Agrandir-WideBlackItalic.otf") format("opentype");
  font-weight: 900;
  font-style: italic;
  font-display: swap;
}
@font-face {
  font-family: "Agrandir Wide Light";
  src: url("/fonts/Agrandir-WideLight.otf") format("opentype");
  font-weight: 300;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Neue Montreal Medium";
  src: url("/fonts/NeueMontreal-Medium.otf") format("opentype");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Neue Montreal Regular";
  src: url("/fonts/NeueMontreal-Regular.otf") format("opentype");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  color: #545555;
  scrollbar-width: none;
  -ms-overflow-style: none;
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
  overflow-x: clip;
}

html::-webkit-scrollbar,
body::-webkit-scrollbar {
  display: none;
}

body {
  margin: 0;
  padding: 0;
  font-family: "Neue Montreal Regular";
  color: #2f3a36;
  background-color: #eee7aa;
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
  overflow-x: clip;
}

body.is-preloading {
  overflow: hidden;
}

.brand-preloader {
  position: fixed;
  inset: 0;
  z-index: 100000;
  display: grid;
  place-items: center;
  overflow: hidden;
  background: #eef0ba;
}

.brand-preloader__wash {
  position: absolute;
  inset: -20%;
  background: radial-gradient(circle at 28% 30%, rgba(208, 255, 157, 0.8), transparent 32%), radial-gradient(circle at 72% 68%, rgba(255, 244, 157, 0.72), transparent 34%), url("/images/yellow-bg.webp") center/cover;
  animation: brandPreloaderDrift 5s ease-in-out infinite alternate;
}

.brand-preloader__content {
  position: relative;
  z-index: 1;
  width: min(82vw, 390px);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-preloader__brand {
  display: grid;
  place-items: center;
}
.brand-preloader__brand > * {
  grid-area: 1/1;
}

.brand-preloader__orbit {
  position: relative;
  width: 170px;
  height: 170px;
  border: 1px solid rgba(72, 90, 46, 0.25);
  border-radius: 50%;
}
.brand-preloader__orbit span {
  position: absolute;
  inset: 15px;
  border: 1px solid rgba(72, 90, 46, 0.18);
  border-radius: inherit;
  animation: brandPreloaderOrbit 4s linear infinite;
}
.brand-preloader__orbit span:last-child {
  inset: 33px;
  animation-direction: reverse;
  animation-duration: 3s;
}
.brand-preloader__orbit span::after {
  content: "";
  position: absolute;
  top: -4px;
  left: 50%;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #677345;
  box-shadow: 0 0 18px rgba(103, 115, 69, 0.65);
}

.brand-preloader__logo {
  position: relative;
  z-index: 2;
  width: min(76vw, 300px);
  height: auto;
}

.brand-preloader__label {
  position: relative;
  z-index: 2;
  margin: 24px 0 0;
  color: #485a2e;
  font-family: "Agrandir Regular";
  font-size: 11px;
  letter-spacing: 0.28em;
  text-transform: uppercase;
}

.brand-preloader__progress {
  position: relative;
  z-index: 2;
  width: min(64vw, 245px);
  height: 2px;
  margin-top: 18px;
  overflow: hidden;
  background: rgba(72, 90, 46, 0.18);
}
.brand-preloader__progress span {
  display: block;
  width: 100%;
  height: 100%;
  background: #485a2e;
  transform-origin: left center;
}

@keyframes brandPreloaderOrbit {
  to {
    transform: rotate(360deg);
  }
}
@keyframes brandPreloaderDrift {
  to {
    transform: scale(1.08) translate3d(1.5%, -1%, 0);
  }
}
@media (prefers-reduced-motion: reduce) {
  .brand-preloader__wash,
  .brand-preloader__orbit span {
    animation: none;
  }
}
img {
  width: 100%;
  max-width: 100%;
  height: auto;
  display: block;
}

a {
  text-decoration: none;
  letter-spacing: 1px;
  font-family: "Agrandir Regular";
  color: #2f3a36;
}

p {
  color: #2f3a36;
}

span {
  color: #5f8f7a;
}

ul {
  list-style: none;
}
ul li {
  list-style: none;
}
ul li::marker {
  display: none;
}
ul li a {
  border: none;
  text-decoration: none;
}

.container {
  max-width: 90%;
  margin: 0 auto;
}

::selection {
  background: #b3d4fc;
  text-shadow: none;
}

::-moz-selection {
  background: #b3d4fc;
  text-shadow: none;
}

.page {
  min-height: 100vh;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  overflow-x: hidden;
  overflow-x: clip;
  display: flex;
  flex-direction: column;
}

section {
  padding-top: 50px;
  padding-bottom: 120px;
}
section.green-bg {
  background-image: url("/images/green-bg-desk.webp");
  background-repeat: no-repeat;
  background-position: center center;
  background-size: cover;
}
@media (max-width: 1000px) {
  section.green-bg {
    background-repeat: repeat;
    background-size: contain;
  }
}
section.white-bg {
  background-image: url("/images/yellow-bg.webp");
  background-repeat: no-repeat;
  background-position: center center;
  background-size: cover;
}
@media (max-width: 767px) {
  section.white-bg {
    background-repeat: repeat;
    background-size: contain;
  }
}
.main {
  flex: 1;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0;
}

h1 {
  font-size: clamp(50px, 3.125vw, 60px);
  font-family: "Agrandir TextBold";
}

@media (max-width: 1280px) {
  h1 {
    font-size: clamp(40px, 3.52vw, 45px);
  }
}
h4 {
  font-size: clamp(20px, 2vw, 21px);
  font-family: "Neue Montreal Regular";
}

h2 {
  font-size: clamp(40px, 2.34vw, 45px);
  font-family: "Agrandir TextBold";
  display: flex;
  flex-direction: column;
  margin-bottom: clamp(22px, 1.46vw, 28px);
}
h2 .subheading {
  font-size: clamp(28px, 1.67vw, 32px);
  font-family: "Neue Montreal Regular";
  color: inherit !important;
}

h3 {
  font-size: clamp(28px, 1.67vw, 32px);
  font-family: "Neue Montreal Regular";
  margin-bottom: clamp(16px, 2vw, 22px);
}

p {
  font-size: clamp(21px, 1.15vw, 22px);
}

@media (max-width: 1365px) {
  h2 {
    font-size: clamp(32px, 3.2vw, 38px);
  }
  h2 .subheading {
    font-size: clamp(25px, 2.45vw, 28px);
  }
  h3 {
    font-size: clamp(25px, 2.45vw, 28px);
  }
  p {
    font-size: clamp(20px, 2vw, 21px);
    font-family: "Neue Montreal Regular";
  }
}
@media (max-width: 999px) {
  h2 {
    font-size: clamp(29px, 7.43vw, 32px);
  }
  h2 .subheading {
    font-size: clamp(22px, 6.41vw, 25px);
  }
  h3 {
    font-size: clamp(22px, 6.41vw, 25px);
  }
  p {
    font-size: clamp(14px, 4.87vw, 18px);
  }
}
h2,
h3 {
  position: relative;
  margin-bottom: 24px;
  padding-bottom: 14px;
  display: inline-flex;
}

h2::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: 0;
  width: 80% !important;
  height: 2px;
  background: currentColor !important;
  display: block !important;
  min-width: 0 !important;
  margin-top: 0 !important;
  transform: none !important;
  transition: none !important;
  animation: none !important;
  will-change: auto;
}

h3::after {
  display: none !important;
}

/* Header */
.header {
  position: absolute;
  top: 32px;
  left: 50%;
  transform: translateX(-50%) translateY(-12px);
  z-index: 999;
  width: min(100% - 48px, 1280px);
  padding: 1rem 1.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
  border-radius: 2rem;
  background: rgba(0, 0, 0, 0.4);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.16);
  backdrop-filter: blur(8px);
  opacity: 0;
  transition: opacity 0.45s ease, transform 0.45s ease;
}
.header:hover {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

.brand {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.logo {
  width: 232px;
  height: auto;
  border-radius: 999px;
}
.logo img {
  width: 100%;
  height: auto;
}

.nav {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  flex: 1;
  justify-content: center;
  font-family: "Agrandir Regular";
}

.navLink {
  position: relative;
  color: #f2eaba;
  padding: 0.35rem 0;
  font-size: 0.95rem;
  font-weight: 500;
  transition: color 0.2s ease;
}
.navLink::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -0.25rem;
  width: var(--underline-width, 100%);
  height: 2px;
  background: #f2eaba;
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.25s ease;
}
.navLink:hover {
  color: #ffffff;
}
.navLink:hover::after {
  transform: scaleX(1);
}

/* Active nav link: show full underline so users know which page is active */
.navLink.active {
  color: #ffffff;
}
.navLink.active::after {
  transform: scaleX(1);
}

.cta {
  padding: 0.75rem 1.4rem;
  border-radius: 10px;
  background: #f2eaba;
  color: #2a2b24;
  font-weight: 600;
  white-space: nowrap;
  transition: transform 0.2s ease, background 0.2s ease;
}
.cta:hover {
  transform: translateY(-1px);
  background: #fff6c9;
}

/* Mobile Menu */
.menuBtn {
  display: none;
  width: 42px;
  height: 42px;
  border: 0;
  background: transparent;
  cursor: pointer;
  position: relative;
  z-index: 1001;
}
.menuBtn span {
  display: block;
  width: 28px;
  height: 2px;
  background: #f2eaba;
  margin: 6px auto;
  border-radius: 10px;
  transition: transform 0.35s ease, opacity 0.25s ease;
}
.menuBtn.active span:nth-child(1) {
  transform: translateY(8px) rotate(45deg);
}
.menuBtn.active span:nth-child(2) {
  opacity: 0;
}
.menuBtn.active span:nth-child(3) {
  transform: translateY(-8px) rotate(-45deg);
}

.mobileMenu {
  position: fixed;
  top: 0;
  left: 0;
  width: 82%;
  max-width: 360px;
  height: 100vh;
  background: #4a4b45;
  z-index: 1000;
  padding: 7rem 2rem 2rem;
  transform: translateX(-100%);
  transition: transform 0.45s cubic-bezier(0.77, 0, 0.175, 1);
}
.mobileMenu.open {
  transform: translateX(0);
}
.mobileMenu.open .mobileNav a {
  transform: translateX(0);
  opacity: 1;
}

.mobileNav {
  display: flex;
  flex-direction: column;
  gap: 1.4rem;
}
.mobileNav a {
  color: #f2eaba;
  font-size: 1.35rem;
  font-weight: 600;
  transform: translateX(-20px);
  opacity: 0;
  transition: all 0.4s ease;
}

.mobileCta {
  margin-top: 1rem;
  padding: 0.9rem 1.2rem;
  border-radius: 10px;
  background: #f2eaba;
  color: #2a2b24 !important;
  text-align: center;
}

body:has(.mobileMenu.open) {
  overflow: hidden;
}

/* Footer */
.footer {
  width: 100%;
  padding: 1.5rem;
  background: #4a4b45;
  display: flex;
  justify-content: center;
  align-items: center;
}

.footer-text {
  margin: 0;
  color: #f2eaba;
  font-size: 1rem;
  font-weight: 600;
}

/* Responsive */
@media (max-width: 1280px) {
  .header {
    width: calc(100% - 32px);
    top: 24px;
    padding: 0.9rem 1rem;
  }
  .logo {
    width: 200px;
  }
  .nav {
    gap: 0.9rem;
  }
  .navLink {
    font-size: 0.85rem;
  }
  .cta {
    padding: 0.65rem 1rem;
    font-size: 0.9rem;
  }
}
@media (max-width: 1100px) {
  .logo {
    width: 180px;
  }
  .nav {
    gap: 0.7rem;
  }
  .navLink {
    font-size: 0.78rem;
  }
  .cta {
    padding: 0.6rem 0.9rem;
    font-size: 0.82rem;
  }
}
@media (max-width: 991px) {
  .header {
    width: calc(100% - 24px);
    top: 16px;
    padding: 0.8rem 1rem;
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  .logo {
    width: 180px;
  }
  .nav,
  .cta {
    display: none;
  }
  .menuBtn {
    display: block;
  }
}
@media (max-width: 575px) {
  .header {
    width: calc(100% - 20px);
    top: 12px;
    border-radius: 1.4rem;
  }
  .logo {
    width: 155px;
  }
  .mobileMenu {
    width: 86%;
  }
}
.footer {
  background: #465827;
  padding: clamp(50px, 4.5vw, 86px) 0;
  color: #f5f1c8;
}
.footer .container {
  max-width: 86%;
  margin: 0 auto;
}
.footer .footer-wrapper {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: clamp(40px, 5vw, 90px);
  align-items: center;
}
.footer .footer-logo {
  width: clamp(260px, 23vw, 440px);
  height: auto;
}
.footer .footer-copy,
.footer p,
.footer a {
  color: #ffffff;
  font-size: clamp(18px, 1.2vw, 24px);
}
.footer .footer-consultation-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: clamp(36px, 3.5vw, 68px);
  padding: 12px 26px;
  border-radius: 10px;
  background: #eee7aa;
  color: #485a2e;
}
.footer .footer-right {
  display: flex;
  flex-direction: column;
  gap: clamp(28px, 2.5vw, 48px);
}
.footer .footer-right p {
  color: #ffffff;
}
.footer .footer-right img {
  width: 20px;
  height: 20px;
}
.footer .footer-address,
.footer .footer-contact-row a {
  display: flex;
  align-items: flex-start;
  gap: 18px;
  color: #ffffff;
  line-height: 1.25;
}
.footer .footer-address {
  max-width: 820px;
}
.footer .footer-contact-row {
  display: flex;
  align-items: center;
  gap: clamp(40px, 5vw, 90px);
  flex-wrap: wrap;
}
.footer .footer-actions {
  display: flex;
  align-items: center;
  gap: clamp(24px, 3vw, 52px);
  flex-wrap: wrap;
}
.footer .footer-actions .footer-consultation-btn {
  margin-top: 0;
  font-size: 14px;
  line-height: 1.2;
  letter-spacing: 1px;
  text-transform: none;
}
.footer .footer-sitemap-link {
  display: inline-flex;
  align-items: center;
  min-height: 48px;
  padding-bottom: 2px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.7);
  transition: color 0.3s ease, border-color 0.3s ease;
}
.footer .footer-sitemap-link:hover {
  color: #eee7aa;
  border-color: #eee7aa;
}
.footer .footer-icon {
  color: #ffffff;
  font-size: clamp(28px, 2vw, 42px);
  line-height: 1;
  flex-shrink: 0;
}

@media (max-width: 991px) {
  .footer .container {
    max-width: 90%;
  }
  .footer .footer-wrapper {
    grid-template-columns: 1fr;
    gap: 42px;
  }
  .footer .footer-copy,
  .footer .footer-consultation-btn {
    margin-top: 32px;
  }
  .footer .footer-contact-row {
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }
  .footer .footer-actions {
    align-items: flex-start;
  }
}
@media (max-width: 575px) {
  .footer {
    padding: 45px 0;
  }
  .footer .footer-logo {
    width: 240px;
  }
  .footer p,
  .footer a {
    font-size: clamp(16px, 4.4vw, 18px);
  }
  .footer .footer-address,
  .footer .footer-contact-row a {
    gap: 14px;
  }
  .footer .footer-icon {
    font-size: 28px;
  }
}

/* Shared typography and interaction treatment for primary site actions. */
.site-cta {
  font-family: "Agrandir Regular", sans-serif !important;
  font-size: 16px !important;
  font-style: normal !important;
  font-weight: 400 !important;
  line-height: 1.2 !important;
  letter-spacing: 1px;
  text-transform: none !important;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

body .site-cta {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  cursor: pointer;
  transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.35s ease, filter 0.35s ease, background-color 0.35s ease;
}
body .site-cta::before {
  content: "";
  position: absolute;
  z-index: -1;
  inset: -40% auto -40% -55%;
  width: 34%;
  transform: skewX(-22deg);
  background: rgba(255, 255, 255, 0.5);
  transition: left 0.55s cubic-bezier(0.2, 0.8, 0.2, 1);
}
body .site-cta:hover {
  transform: translateY(-4px) scale(1.025) !important;
  box-shadow: 0 14px 30px rgba(29, 45, 22, 0.22);
  filter: saturate(1.08);
}
body .site-cta:hover::before {
  left: 125%;
}
body .site-cta:focus-visible {
  outline: 3px solid rgba(238, 231, 170, 0.9);
  outline-offset: 4px;
}

@media (max-width: 575px) {
  body .site-cta {
    display: inline-flex;
    width: 100%;
    max-width: 280px;
    min-height: 52px;
    padding: 12px 20px;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    font-size: 14px !important;
    line-height: 1.2;
    text-align: center;
    text-transform: none !important;
  }

  .footer .footer-actions .footer-consultation-btn {
    font-size: 14px;
    text-transform: none !important;
  }

  .beyond-consultation-section .consultation-btn {
    text-transform: none !important;
  }
  .site-cta {
  /* font-family: "Agrandir Regular", sans-serif !important; */
  font-size: 14px !important;
  }
}

@media (hover: hover) and (pointer: fine) {
  :is(.expertise-list, .procedure-grid, .evaluated-grid, .gallery-masonry, .selected-work-grid, .papers-grid) img {
    transition: transform 0.55s ease;
  }
  .expertise-item:hover img,
  .procedure-card:hover img,
  .evaluated-card:hover img,
  .gallery-card:hover img,
  .selected-work-card:hover img,
  .paper-card:hover img {
    transform: scale(1.035);
  }
}
.inside-page header {
  position: fixed;
  opacity: 1;
}
.inside-page .inside-banner {
  text-align: center;
  align-items: center;
  padding-bottom: 50px;
  padding-top: 120px;
}

.home-page header {
  opacity: 1;
  position: fixed;
}
.home-page .inside-banner {
  text-align: center;
  align-items: center;
  padding-bottom: 50px;
  padding-top: 120px;
}

