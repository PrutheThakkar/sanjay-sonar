.hero {
  position: relative;
  width: 100%;
  height: 100svh;
  min-height: 720px;
  overflow: hidden;
  background: #000;
}
.hero:hover .hero-logo {
  opacity: 1;
  transform: translateY(0) scale(1);
}

.hero-bg {
  position: absolute;
  inset: 0;
  z-index: 1;
}
.hero-bg picture {
  height: 100vh;
  position: relative;
  display: block;
}
.hero-bg picture img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero-img {
  object-fit: cover;
  object-position: center;
}

.hero-content {
  position: relative;
  z-index: 2;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-logo {
  width: auto;
  height: clamp(580px, 70vh, 680px);
  opacity: 0;
  transform: translateY(18px) scale(0.96);
  transition: opacity 0.6s ease, transform 0.6s ease;
}

.social-links {
  position: absolute;
  left: 50%;
  bottom: clamp(38px, 8vh, 10px);
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  gap: clamp(12px, 1.5vw, 18px);
  z-index: 3;
}
.social-links a {
  width: clamp(28px, 3vw, 34px);
  height: clamp(28px, 3vw, 34px);
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: #b50000;
  font-size: 14px;
  font-weight: 700;
  opacity: 0.7;
  transition: all 0.35s ease;
}
.social-links a svg {
  width: 100%;
  height: 100%;
  fill: rgba(255, 255, 255, 0.9);
  transition: fill 0.35s ease;
}
.social-links a:hover {
  opacity: 1;
  transform: translateY(-4px) scale(1.1);
}
.social-links a:hover svg {
  fill: #ffffff;
}
.social-links:hover a {
  opacity: 1;
}
.social-links:hover a svg {
  fill: #ffffff;
}

@media (max-width: 1440px) {
  .hero {
    min-height: 650px;
  }
  .hero-logo {
    height: clamp(260px, 66vh, 590px);
  }
}
@media (max-width: 1280px) {
  .hero {
    min-height: 620px;
  }
  .hero-logo {
    height: clamp(240px, 64vh, 540px);
  }
}
@media (max-width: 991px) {
  .hero {
    height: 100svh;
    min-height: 600px;
  }
  .hero-img {
    object-position: center;
  }
  .hero-logo {
    height: auto;
  }
  .social-links {
    bottom: 7vh;
  }
  .social-links a {
    width: 32px;
    height: 32px;
  }
}
@media (max-width: 767px) {
  .hero {
    min-height: 560px;
  }
  .hero-logo {
    width: 100%;
  }
  .social-links {
    bottom: 6vh;
  }
}
@media (max-width: 575px) {
  .hero {
    min-height: 520px;
  }
  .social-links {
    bottom: 5.5vh;
    gap: 14px;
  }
  .social-links a {
    width: 30px;
    height: 30px;
  }
}
/* When selected-work section enters viewport on mobile, remove the green overlay */
@media (max-width: 575px) {
  .selected-work-section.section-active .img-wrap::after {
    transform: scaleY(0);
    opacity: 0;
    backdrop-filter: blur(0);
  }
  .selected-work-section.section-active .img-wrap img {
    filter: saturate(1.06) contrast(1.03);
    transform: scale(1.02);
  }
}
@media (max-width: 390px) {
  .hero {
    min-height: 500px;
  }
}
.about-section {
  padding-top: clamp(70px, 6.25vw, 120px);
  padding-bottom: clamp(70px, 6.25vw, 120px);
  display: flex;
  align-items: center;
}
.about-section .about-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
}
.about-section .left,
.about-section .right {
  width: 50%;
}
.about-section .left {
  display: flex;
  justify-content: center;
}
.about-section .about-img-wrapper {
  width: 100%;
  max-width: 720px;
  aspect-ratio: 1078/1230;
  border-radius: 20px;
  overflow: hidden;
  margin-right: 50px;
  background: linear-gradient(0deg, rgb(255, 255, 255) 0%, rgba(255, 255, 255, 0) 100%);
}
@media (max-width: 767px) {
  .about-section .about-img-wrapper {
    margin-right: 0;
  }
}
.about-section .about-img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.about-section .right {
  display: flex;
  flex-direction: column;
}
.about-section .right h2 {
  color: #ffffff;
}
.about-section .right h2 .subheading {
  display: block;
  color: #eee7aa;
  font-size: clamp(22px, 1.45vw, 28px);
  font-weight: 400;
  margin-top: clamp(10px, 0.8vw, 16px);
}
.about-section .right h3 {
  color: #eee7aa;
  margin-top: clamp(36px, 2.6vw, 50px);
}
.about-section .right h2::after,
.about-section .right h3::after {
  background: #ffffff;
}
.about-section .right p {
  color: #ffffff;
  line-height: 1.45;
}
.about-section .right .honor-div {
  margin-bottom: clamp(18px, 1.5vw, 28px);
}
.about-section .right .honor-div .bold {
  color: #eee7aa;
}

@media (max-width: 1365px) {
  .about-section .about-wrapper {
    gap: clamp(35px, 4vw, 70px);
  }
  .about-section .about-img-wrapper {
    width: clamp(330px, 29vw, 400px);
  }
  .about-section .right {
    max-width: 560px;
  }
}
@media (max-width: 1100px) {
  .about-section .about-wrapper {
    gap: 35px;
  }
  .about-section .about-img-wrapper {
    width: 330px;
  }
  .about-section .right h2 .subheading {
    font-size: 22px;
  }
  .about-section .right p {
    line-height: 1.4;
  }
}
@media (max-width: 991px) {
  .about-section {
    padding-top: 80px;
    padding-bottom: 80px;
    min-height: auto;
  }
  .about-section .about-wrapper {
    flex-direction: column;
    gap: 40px;
  }
  .about-section .left {
    height: auto;
    border-radius: 20px;
    overflow: hidden;
  }
  .about-section .left,
  .about-section .right {
    width: 100%;
  }
  .about-section .about-img-wrapper {
    width: min(420px, 82vw);
  }
  .about-section .right {
    max-width: 100%;
    text-align: left;
  }
  .about-section .right h2 .subheading {
    font-size: clamp(20px, 4vw, 24px);
  }
  .about-section .right h3 {
    margin-top: 36px;
  }
}
@media (max-width: 575px) {
  .about-section {
    padding-top: 60px;
    padding-bottom: 60px;
  }
  .about-section .about-wrapper {
    gap: 32px;
  }
  .about-section .about-img-wrapper {
    width: 100%;
    border-radius: 16px;
  }
  .about-section .right h3 {
    margin-top: 30px;
  }
  .about-section .right .honor-div {
