  overflow: hidden;
  border-radius: clamp(14px, 1.1vw, 22px);
  background: rgba(255, 255, 255, 0.2);
}
.beyond-consultation-section .beyond-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transition: transform 0.65s ease;
}
.beyond-consultation-section .beyond-img:hover img {
  transform: scale(1.06);
}
.beyond-consultation-section .beyond-img.small {
  aspect-ratio: 420/260;
}
.beyond-consultation-section .beyond-img.large {
  aspect-ratio: 720/650;
  height: clamp(420px, 34vw, 650px);
}
.beyond-consultation-section .consultation-content {
  margin-top: clamp(70px, 6.5vw, 85px);
  max-width: 1180px;
}
.beyond-consultation-section .consultation-content h2 {
  margin-bottom: clamp(22px, 1.8vw, 34px);
}
.beyond-consultation-section .consultation-content p {
  margin-bottom: clamp(14px, 1.2vw, 22px);
}
.beyond-consultation-section .consultation-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: clamp(28px, 2.8vw, 54px);
  padding: clamp(8px, 0.7vw, 12px) clamp(18px, 1.6vw, 32px);
  border-radius: 10px;
  background: #eee7aa;
  color: #485a2e;
  text-transform: none;
  transition: transform 0.35s ease, background 0.35s ease;
}
.beyond-consultation-section .consultation-btn:hover {
  transform: translateY(-3px);
  background: #fff6bf;
}

@media (max-width: 991px) {
  .beyond-consultation-section {
    padding: 70px 0;
  }
  .beyond-consultation-section .container {
    max-width: 90%;
  }
  .beyond-consultation-section .beyond-grid {
    grid-template-columns: 1fr;
    gap: 34px;
  }
  .beyond-consultation-section .beyond-right {
    order: 2;
  }
  .beyond-consultation-section .beyond-small-images {
    grid-template-columns: repeat(2, 1fr);
  }
  .beyond-consultation-section .beyond-img.large {
    height: auto;
    aspect-ratio: 720/520;
  }
  .beyond-consultation-section .consultation-content {
    margin-top: 70px;
  }
}
@media (max-width: 575px) {
  .beyond-consultation-section {
    padding: 55px 0;
  }
  .beyond-consultation-section .beyond-small-images {
    grid-template-columns: 1fr;
    gap: 18px;
  }
  .beyond-consultation-section .beyond-img.large {
    aspect-ratio: 1/0.85;
  }
  .beyond-consultation-section .consultation-content {
    margin-top: 55px;
  }
  .beyond-consultation-section .consultation-btn {
    width: 100%;
    font-size: 14px;
  }
}
/* ===============================
   Modern Zoom Preloader
================================ */
.site-preloader {
  position: fixed;
  inset: 0;
  z-index: 99999;
  background: radial-gradient(circle at center, rgba(255, 255, 255, 0.1), transparent 34%), linear-gradient(135deg, #101511, #2f3a36);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 1;
  visibility: visible;
  transform: scale(1);
  transition: opacity 0.8s ease, visibility 0.8s ease, transform 1s cubic-bezier(0.16, 1, 0.3, 1), filter 1s cubic-bezier(0.16, 1, 0.3, 1);
}

.site-preloader::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at center, rgba(255, 255, 255, 0.16), transparent 38%);
  animation: preloaderGlow 1.8s ease-in-out infinite;
}

.preloader-hide {
  opacity: 0;
  visibility: hidden;
  transform: scale(1.18);
  filter: blur(20px);
}

.preloader-inner {
  position: relative;
  z-index: 2;
  text-align: center;
  transform: scale(1);
  animation: preloaderInnerFloat 1.8s ease-in-out infinite;
}

.preloader-mark {
  position: relative;
  width: 96px;
  height: 96px;
  margin: 0 auto 22px;
}

.preloader-mark span {
  position: absolute;
  inset: 0;
  border: 1px solid rgba(255, 255, 255, 0.38);
  border-radius: 50%;
  animation: loaderPulse 1.6s ease-in-out infinite;
}

.preloader-mark span:nth-child(2) {
  inset: 14px;
  animation-delay: 0.2s;
}

.preloader-mark span:nth-child(3) {
  inset: 28px;
  animation-delay: 0.4s;
}

.preloader-inner p {
  color: #fff;
  font-size: 14px;
  letter-spacing: 4px;
  text-transform: uppercase;
  margin-bottom: 18px;
}

.preloader-line {
  width: 220px;
  height: 2px;
  background: rgba(255, 255, 255, 0.18);
  overflow: hidden;
  margin: 0 auto;
  border-radius: 10px;
}

.preloader-line span {
  display: block;
  width: 100%;
  height: 100%;
  background: #ffffff;
  transform-origin: center;
  animation: loaderLine 1.8s ease forwards;
}

@keyframes loaderPulse {
  0% {
    transform: scale(0.75);
    opacity: 0.18;
  }
  50% {
    transform: scale(1);
    opacity: 1;
  }
  100% {
    transform: scale(1.25);
    opacity: 0;
  }
}
@keyframes loaderLine {
  from {
    transform: scaleX(0);
  }
  to {
    transform: scaleX(1);
  }
}
@keyframes preloaderGlow {
  0% {
    transform: scale(0.7);
    opacity: 0.35;
  }
  50% {
    transform: scale(1.15);
    opacity: 1;
  }
  100% {
    transform: scale(1.45);
    opacity: 0.25;
  }
}
@keyframes preloaderInnerFloat {
  0% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.04);
  }
  100% {
    transform: scale(1);
  }
}
/* ===============================
   Mobile Adjustment
================================ */
@media (max-width: 767px) {
  .hero {
    min-height: 100svh;
  }
  .hero-bg .hero-img {
    transform: scale(1.2);
  }
  .preloader-mark {
    width: 76px;
    height: 76px;
  }
  .preloader-inner p {
    font-size: 11px;
    letter-spacing: 3px;
  }
  .preloader-line {
    width: 170px;
  }
  @keyframes heroZoomReveal {
    0% {
      opacity: 0;
      transform: scale(1.24);
      filter: blur(22px) grayscale(1) brightness(0.45);
    }
    42% {
      opacity: 1;
      transform: scale(2);
      filter: blur(10px) grayscale(0.4) brightness(0.82);
    }
    72% {
      opacity: 1;
      transform: scale(1.03);
      filter: blur(2px) grayscale(0.1) brightness(1.04);
    }
    100% {
      opacity: 1;
      transform: scale(1);
      filter: blur(0) grayscale(0) brightness(1);
    }
  }
}
/* ===============================
   Global Clip Path Image Reveal
================================ */
.clip-reveal-section {
  overflow: hidden;
}

.site-img-reveal {
  position: relative;
  overflow: hidden;
  opacity: 0;
  transform: translateY(35px);
  clip-path: polygon(0 100%, 100% 100%, 100% 100%, 0 100%);
  will-change: clip-path, transform, opacity;
}

.site-img-reveal img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  transform: scale(1.16);
  filter: blur(8px) brightness(0.78);
  will-change: transform, filter;
}

.site-img-reveal::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 2;
  background: #2f3a36;
  transform: translateY(0);
  pointer-events: none;
}

.clip-reveal-section.section-active .site-img-reveal {
  animation: globalImageWrapperReveal 1s cubic-bezier(0.77, 0, 0.175, 1) forwards;
}

.clip-reveal-section.section-active .site-img-reveal img {
  animation: globalImageZoomReveal 1.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.clip-reveal-section.section-active .site-img-reveal::after {
  animation: globalImageOverlayReveal 1s cubic-bezier(0.77, 0, 0.175, 1) forwards;
}

/* stagger delay */
.clip-reveal-section.section-active .delay-1,
.clip-reveal-section.section-active .delay-1 img,
.clip-reveal-section.section-active .delay-1::after {
  animation-delay: 0.1s;
}

.clip-reveal-section.section-active .delay-2,
.clip-reveal-section.section-active .delay-2 img,
.clip-reveal-section.section-active .delay-2::after {
  animation-delay: 0.25s;
}

.clip-reveal-section.section-active .delay-3,
.clip-reveal-section.section-active .delay-3 img,
.clip-reveal-section.section-active .delay-3::after {
  animation-delay: 0.4s;
}

.clip-reveal-section.section-active .delay-4,
.clip-reveal-section.section-active .delay-4 img,
.clip-reveal-section.section-active .delay-4::after {
  animation-delay: 0.55s;
}

.clip-reveal-section.section-active .delay-5,
.clip-reveal-section.section-active .delay-5 img,
.clip-reveal-section.section-active .delay-5::after {
  animation-delay: 0.7s;
}

.clip-reveal-section.section-active .delay-6,
.clip-reveal-section.section-active .delay-6 img,
.clip-reveal-section.section-active .delay-6::after {
  animation-delay: 0.85s;
}

@keyframes globalImageWrapperReveal {
  0% {
    opacity: 0;
    transform: translateY(35px);
    clip-path: polygon(0 100%, 100% 100%, 100% 100%, 0 100%);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
  }
}
@keyframes globalImageZoomReveal {
  0% {
    transform: scale(1.16);
    filter: blur(8px) brightness(0.78);
  }
  100% {
    transform: scale(1);
    filter: blur(0) brightness(1);
  }
}
@keyframes globalImageOverlayReveal {
  0% {
    transform: translateY(0);
  }
  100% {
    transform: translateY(-105%);
  }
}
/* optional hover zoom */
.site-img-reveal:hover img {
  transform: scale(1.06);
  transition: transform 0.7s ease;
}

@media (max-width: 767px) {
  .site-img-reveal {
    transform: translateY(25px);
  }
  .clip-reveal-section.section-active .delay-1,
  .clip-reveal-section.section-active .delay-2,
  .clip-reveal-section.section-active .delay-3,
  .clip-reveal-section.section-active .delay-4,
  .clip-reveal-section.section-active .delay-5,
  .clip-reveal-section.section-active .delay-6 {
    animation-delay: 0.1s;
  }
}

