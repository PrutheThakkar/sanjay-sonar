  }
}
.years-Mastery {
  padding: clamp(70px, 6.25vw, 120px) 0;
}
.years-Mastery h3 {
  display: inline-flex;
  align-items: flex-end;
  /* justify-content: center; */
  gap: clamp(10px, 1vw, 18px);
  margin-bottom: clamp(40px, 4.16vw, 80px);
  color: #676f43;
  line-height: 1.1;
}
.years-Mastery h3 span {
  display: inline-flex;
  width: clamp(70px, 5.2vw, 100px);
  flex-shrink: 0;
}
.years-Mastery h3 span img {
  width: 100%;
  height: auto;
}
.years-Mastery ul {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: clamp(36px, 3.5vw, 64px) clamp(36px, 4vw, 80px);
}
.years-Mastery li {
  width: 100%;
}
.years-Mastery .complex-sec-wrap {
  width: 100%;
  cursor: pointer;
}
.years-Mastery .complex-sec-wrap:hover .img-wrap::after {
  height: 0%;
}
.years-Mastery .complex-sec-wrap:hover .img-wrap img {
  transform: scale(1.06);
  filter: saturate(1.15) contrast(1.05);
}
.years-Mastery .complex-sec-wrap:hover h4 {
  color: #676f43;
  transform: translateY(-2px);
}
.years-Mastery .img-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 442/330;
  border-radius: clamp(12px, 0.93vw, 18px);
  overflow: hidden;
  margin-bottom: clamp(10px, 0.8vw, 16px);
}
.years-Mastery .img-wrap::after {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(97, 216, 86, 0.3529411765);
  transform-origin: top;
  transform: scaleY(1);
  transition: transform 0.7s cubic-bezier(0.77, 0, 0.175, 1);
  display: none;
}
.years-Mastery .img-wrap .complex-sec-wrap:hover .img-wrap::after {
  transform: scaleY(0);
}
.years-Mastery .img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  filter: saturate(0.8) contrast(0.95);
  transition: transform 0.6s ease, filter 0.6s ease;
}
.years-Mastery .img-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 442/330;
  border-radius: clamp(12px, 0.93vw, 18px);
  overflow: hidden;
  margin-bottom: clamp(10px, 0.8vw, 16px);
}
.years-Mastery .img-wrap::after {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(97, 216, 86, 0.3529411765);
  backdrop-filter: blur(2px);
  z-index: 2;
  opacity: 1;
  transition: opacity 0.45s ease, backdrop-filter 0.45s ease;
  pointer-events: none;
}
.years-Mastery .img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  filter: saturate(0.8) contrast(0.95);
  transition: transform 0.6s ease, filter 0.6s ease;
}
.years-Mastery h4 {
  color: #2f3a36;
  font-size: clamp(18px, 1.15vw, 22px);
  line-height: 1.3;
  font-weight: 400;
  text-transform: capitalize;
  transition: color 0.35s ease, transform 0.35s ease;
}
.years-Mastery .btn-wrapper {
  margin-top: 30;
  display: flex;
  justify-content: right;
}
.years-Mastery .btn-wrapper .cta {
  background: #485a2e;
  color: #f2eaba;
}

@media (max-width: 1365px) {
  .years-Mastery ul {
    gap: 36px 50px;
  }
