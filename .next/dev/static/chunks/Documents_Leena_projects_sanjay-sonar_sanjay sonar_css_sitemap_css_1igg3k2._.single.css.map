.sitemap-page .inside-banner {
  min-height: 320px;
}

.sitemap-page .inside-banner .container {
  align-self: flex-end;
  padding-bottom: clamp(34px, 4vw, 64px);
}

.sitemap-eyebrow {
  margin-bottom: 10px;
  color: #d9e5a9;
  font-size: 13px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.sitemap-main,
.sitemap-expertise,
.sitemap-contact {
  padding: clamp(70px, 7vw, 130px) 0;
}

.sitemap-page section > .container {
  max-width: 86%;
}

.sitemap-intro {
  max-width: none;
  margin-bottom: clamp(44px, 5vw, 82px);
}

.sitemap-intro h2 {
  white-space: nowrap;
}

.sitemap-intro > span,
.sitemap-section-heading > span {
  display: block;
  margin-bottom: 12px;
  color: #5f8f7a;
  font-size: 13px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.sitemap-intro h2,
.sitemap-section-heading h2 {
  color: #485a2e;
  font-family: "Agrandir TextBold";
  font-size: clamp(34px, 3.2vw, 62px);
  line-height: 1.05;
}

.sitemap-intro h2::after,
.sitemap-section-heading h2::after {
  display: none;
}

.sitemap-intro p {
  max-width: 660px;
  margin-top: 20px;
  color: #485a2e;
  font-size: clamp(17px, 1.1vw, 21px);
  line-height: 1.55;
}

.sitemap-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  border-top: 1px solid rgba(72, 90, 46, 0.3);
}

.sitemap-card {
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 22px;
  align-items: start;
  min-height: 150px;
  padding: clamp(26px, 2.5vw, 42px) 0;
  color: #485a2e;
  border-bottom: 1px solid rgba(72, 90, 46, 0.3);
  text-decoration: none;
  transition: padding 0.3s ease, background-color 0.3s ease;
}

.sitemap-card:nth-child(odd) {
  padding-right: clamp(22px, 3vw, 54px);
  border-right: 1px solid rgba(72, 90, 46, 0.3);
}

.sitemap-card:nth-child(even) {
  padding-left: clamp(22px, 3vw, 54px);
}

.sitemap-card:hover {
  background: rgba(238, 231, 170, 0.42);
}

.sitemap-number,
.sitemap-arrow {
  color: #5f8f7a;
  font-size: 14px;
}

.sitemap-arrow {
  font-size: 24px;
  transition: transform 0.3s ease;
}

.sitemap-card:hover .sitemap-arrow {
  transform: translate(4px, -4px);
}

.sitemap-card-copy {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.sitemap-card strong,
.sitemap-contact-grid strong {
  color: #485a2e;
  font-family: "Agrandir Regular";
  font-size: clamp(22px, 1.55vw, 30px);
}

.sitemap-card small,
.sitemap-contact-grid small {
  color: #596359;
  font-size: 16px;
  line-height: 1.45;
}

.sitemap-expertise .sitemap-section-heading h2,
.sitemap-expertise .sitemap-section-heading > span {
  color: #f2edbd;
}

.sitemap-section-heading {
  margin-bottom: clamp(38px, 4vw, 68px);
}

.sitemap-link-list {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  border-top: 1px solid rgba(242, 237, 189, 0.35);
}

.sitemap-link-list a {
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 16px;
  align-items: center;
  min-height: 105px;
  padding: 22px;
  color: #f5f1c8;
  border-right: 1px solid rgba(242, 237, 189, 0.22);
  border-bottom: 1px solid rgba(242, 237, 189, 0.35);
  text-decoration: none;
  transition: color 0.3s ease, background-color 0.3s ease;
}

.sitemap-link-list a:nth-child(3n) {
  border-right: 0;
}

.sitemap-link-list a:hover {
  color: #485a2e;
  background: #eee7aa;
}

.sitemap-link-list a > span:first-child {
  color: inherit;
  font-size: 12px;
  opacity: 0.75;
}

.sitemap-link-list a > span:last-child {
  color: inherit;
  font-size: 20px;
}

.sitemap-link-list strong {
  color: inherit;
  font-size: clamp(16px, 1vw, 20px);
  line-height: 1.25;
}

.sitemap-contact-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: clamp(18px, 2vw, 34px);
  max-width: 900px;
}

.sitemap-contact-grid a {
  display: flex;
  flex-direction: column;
  min-height: 230px;
  padding: clamp(28px, 3vw, 48px);
  color: #485a2e;
  background: rgba(225, 234, 172, 0.55);
  border: 1px solid rgba(72, 90, 46, 0.25);
  border-radius: clamp(18px, 1.5vw, 28px);
  text-decoration: none;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.sitemap-contact-grid a:hover {
  transform: translateY(-6px);
  box-shadow: 0 20px 45px rgba(72, 90, 46, 0.14);
}

.sitemap-contact-grid small {
  max-width: 480px;
  margin-top: 14px;
}

.sitemap-contact-grid a > span {
  margin-top: auto;
  padding-top: 30px;
  color: #5f8f7a;
  font-weight: 600;
}

@media (max-width: 991px) {
  .sitemap-link-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .sitemap-link-list a:nth-child(3n) {
    border-right: 1px solid rgba(242, 237, 189, 0.22);
  }
  .sitemap-link-list a:nth-child(2n) {
    border-right: 0;
  }
}

@media (max-width: 700px) {
  .sitemap-intro h2 {
    white-space: normal;
  }

  .sitemap-grid,
  .sitemap-contact-grid,
  .sitemap-link-list {
    grid-template-columns: 1fr;
  }
  .sitemap-card:nth-child(n),
  .sitemap-link-list a:nth-child(n) {
    padding-left: 0;
    padding-right: 0;
    border-right: 0;
  }
  .sitemap-link-list a:nth-child(n) {
    padding: 20px 8px;
  }
  .sitemap-card {
    min-height: 130px;
  }
}
