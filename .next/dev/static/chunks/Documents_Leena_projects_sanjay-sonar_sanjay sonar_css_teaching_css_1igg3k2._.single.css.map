.teaching-page {
  width: 100%;
  overflow: hidden;
  color: #485a2e;
}
.teaching-page .container {
  max-width: 90%;
  margin: 0 auto;
  position: relative;
  z-index: 2;
}

/* Common heading underline */
.lined-title {
  display: inline-block;
  position: relative;
  color: inherit;
  font-weight: 800;
  line-height: 1.1;
  margin: 0;
}
.lined-title::after {
  content: "";
  display: block;
  width: 100%;
  height: 2px;
  background: currentColor;
  margin-top: 10px;
}

/* Common image */
.teaching-image {
  width: 100%;
  overflow: hidden;
  border-radius: 18px;
  background: #d9d9d9;
}
.teaching-image img {
  width: 100%;
  height: 100%;
  display: block;
  -o-object-fit: cover;
     object-fit: cover;
}
.teaching-image.large {
  height: clamp(380px, 35vw, 560px);
}
.teaching-image.small {
  height: clamp(250px, 22vw, 360px);
}

/* Top intro section */
.teaching-intro {
  position: relative;
  padding: clamp(70px, 7vw, 120px) 0 clamp(70px, 7vw, 115px);
  background: linear-gradient(90deg, rgba(226, 255, 196, 0.9) 0%, rgba(235, 255, 190, 0.88) 52%, rgba(255, 240, 165, 0.82) 100%), url("/images/surgical-bg-pattern.png");
  background-size: cover;
  background-position: center;
}

.teaching-intro-grid {
  display: grid;
  grid-template-columns: 1.05fr 1fr;
  gap: clamp(48px, 5vw, 86px);
  align-items: center;
}

.teaching-copy {
  max-width: 650px;
}
.teaching-copy h1 {
  font-size: clamp(34px, 3.4vw, 54px);
  margin-bottom: clamp(18px, 1.5vw, 28px);
}
.teaching-copy h2 {
  color: #485a2e;
  margin: 0 0 clamp(42px, 4vw, 70px);
}
.teaching-copy h2 .subheading,
.teaching-copy h2 span {
  color: #485a2e;
}
.teaching-copy p {
  color: #485a2e;
  font-size: clamp(17px, 1.25vw, 22px);
  line-height: 1.7;
  margin: 0;
  max-width: 620px;
}
.teaching-copy p:not(:last-child) {
  margin-bottom: clamp(28px, 2.8vw, 48px);
}

/* Dark green academic section */
.teaching-academic {
  position: relative;
  padding: clamp(80px, 7vw, 130px) 0 clamp(80px, 7vw, 130px);
  color: #ffffff;
  background: linear-gradient(90deg, rgba(55, 88, 40, 0.96) 0%, rgba(91, 136, 63, 0.92) 52%, rgba(145, 221, 89, 0.86) 100%), url("/images/surgical-bg-pattern.png");
  background-size: cover;
  background-position: center;
}
.teaching-academic .lined-title {
  color: #ffffff;
  font-size: clamp(25px, 2.3vw, 38px);
  margin-bottom: clamp(28px, 2.5vw, 42px);
}

.academic-row {
  display: grid;
  grid-template-columns: 1.25fr 0.75fr;
  gap: clamp(52px, 7vw, 120px);
  align-items: center;
}
.academic-row.first {
  margin-bottom: clamp(80px, 8vw, 140px);
}
.academic-row.second {
  grid-template-columns: 0.85fr 1.15fr;
}

.academic-copy {
  max-width: 850px;
}
.academic-copy p {
  color: rgba(255, 255, 255, 0.94);
  font-size: clamp(17px, 1.25vw, 22px);
  line-height: 1.75;
  margin: 0;
}
.academic-copy p:not(:last-child) {
  margin-bottom: clamp(30px, 3vw, 52px);
}

/* Philosophy section */
.teaching-philosophy {
  position: relative;
  padding: clamp(80px, 7vw, 130px) 0 clamp(90px, 8vw, 150px);
  background: linear-gradient(90deg, rgba(226, 255, 196, 0.9) 0%, rgba(236, 255, 190, 0.88) 55%, rgba(255, 240, 165, 0.82) 100%), url("/images/surgical-bg-pattern.png");
  background-size: cover;
  background-position: center;
}

.philosophy-content {
  max-width: 1180px;
}
.philosophy-content .lined-title {
  font-size: clamp(27px, 2.6vw, 42px);
  margin-bottom: clamp(28px, 2.5vw, 44px);
}
.philosophy-content > p {
  color: #485a2e;
  font-size: clamp(17px, 1.25vw, 22px);
  line-height: 1.65;
  margin: 0;
}
.philosophy-content > p:not(:last-child) {
  margin-bottom: clamp(26px, 2.5vw, 44px);
}

.philosophy-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: clamp(24px, 2.5vw, 48px);
  max-width: 1180px;
  margin: clamp(45px, 4vw, 70px) 0 clamp(42px, 4vw, 70px);
}

.philosophy-item {
  display: flex;
  flex-direction: column;
  gap: clamp(14px, 1.5vw, 24px);
  align-items: center;
  text-align: center;
}
.philosophy-item p {
  color: #485a2e;
  font-size: clamp(17px, 1.2vw, 22px);
  line-height: 1.55;
  margin: 0;
}

.philosophy-icon {
  width: 70px;
  height: 70px;
  border-radius: 50%;
  overflow: hidden;
}
.philosophy-icon img {
  width: 100%;
  height: 100%;
  -o-object-fit: contain;
     object-fit: contain;
  display: block;
}

.philosophy-closing {
  margin-top: clamp(36px, 4vw, 65px) !important;
}

/* Tablet */
@media (max-width: 991px) {
  .teaching-page .container {
    max-width: 90%;
  }
  .teaching-intro,
  .teaching-academic,
  .teaching-philosophy {
    padding: 70px 0 95px;
  }
  .teaching-intro-grid,
  .academic-row,
  .academic-row.second {
    grid-template-columns: 1fr;
    gap: 42px;
  }
  .academic-row.first {
    margin-bottom: 80px;
  }
  .teaching-copy,
  .academic-copy {
    max-width: 100%;
  }
  .teaching-image.large,
  .teaching-image.small {
    height: 420px;
  }
  .academic-row.second .teaching-image {
    order: 1;
  }
  .academic-row.second .academic-copy {
    order: 2;
  }
  .philosophy-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 100%;
    gap: 38px 60px;
  }
}
/* Mobile */
@media (max-width: 575px) {
  .teaching-intro,
  .teaching-academic,
  .teaching-philosophy {
    padding: 55px 0 75px;
  }
  .teaching-intro-grid,
  .academic-row,
  .academic-row.second {
    gap: 34px;
  }
  .teaching-image.large,
  .teaching-image.small {
    height: 285px;
    border-radius: 14px;
  }
  .teaching-copy h1 {
    font-size: 32px;
  }
  .teaching-copy h2 {
    margin-bottom: 30px;
  }
  .teaching-copy p {
    font-size: 16px;
    line-height: 1.7;
  }
  .teaching-academic .lined-title {
    font-size: 24px;
  }
  .academic-copy p {
    font-size: 16px;
    line-height: 1.7;
  }
  .philosophy-content .lined-title {
    font-size: 25px;
  }
  .philosophy-content > p {
    font-size: 16px;
  }
  .philosophy-grid {
    grid-template-columns: 1fr;
    gap: 32px;
    margin: 38px 0 42px;
  }
  .philosophy-item {
    gap: 20px;
  }
  .philosophy-item p {
    font-size: 16px;
  }
  .philosophy-icon {
    width: 56px;
    height: 56px;
  }
}
.work-swiper-section {
  width: 100%;
  position: relative;
  overflow: hidden;
  padding: clamp(70px, 7vw, 120px) 0 clamp(70px, 7vw, 120px);
  background: linear-gradient(90deg, rgba(54, 83, 40, 0.96) 0%, rgba(92, 137, 62, 0.91) 48%, rgba(142, 222, 88, 0.9) 100%), url("/images/surgical-bg-pattern.png");
  background-size: cover;
  background-position: center;
}

.work-swiper-bg {
  position: relative;
  width: 100%;
}

.work-swiper {
  width: 100%;
  padding: 0 0 clamp(65px, 6vw, 95px);
  overflow: visible;
}
.work-swiper .swiper-wrapper {
  align-items: center;
}
.work-swiper .swiper-slide {
  width: clamp(650px, 62vw, 1280px);
  transition: transform 0.75s ease, opacity 0.75s ease, filter 0.75s ease;
  transform: scale(0.82);
  opacity: 0.38;
  filter: blur(1px);
}
.work-swiper .swiper-slide-active {
  transform: scale(1);
  opacity: 1;
  filter: blur(0);
  z-index: 5;
}
.work-swiper .swiper-slide-prev,
.work-swiper .swiper-slide-next {
  opacity: 0.52;
  filter: blur(0.5px);
  z-index: 2;
}

.work-slide-card {
  width: 100%;
  height: clamp(360px, 33vw, 610px);
  border-radius: clamp(34px, 4vw, 70px);
  overflow: hidden;
  background: #d9d9d9;
  box-shadow: 0 24px 80px rgba(28, 54, 25, 0.22);
}
.work-slide-card img {
  width: 100%;
  height: 100%;
  display: block;
  -o-object-fit: cover;
     object-fit: cover;
}

/* Controls */
.work-swiper-controls {
  position: absolute;
  left: 50%;
  bottom: 0;
  z-index: 10;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: clamp(22px, 2vw, 34px);
}

.work-swiper-prev,
.work-swiper-next {
  width: 42px;
  height: 42px;
  border: 0;
  background: transparent;
  color: #ffffff;
  font-size: 46px;
  line-height: 1;
  cursor: pointer;
  display: grid;
  place-items: center;
  transition: transform 0.3s ease, opacity 0.3s ease;
}
.work-swiper-prev:hover,
.work-swiper-next:hover {
  transform: scale(1.12);
  opacity: 0.85;
}

.work-swiper-pagination {
  position: relative !important;
  inset: auto !important;
  width: auto !important;
  display: flex;
  align-items: center;
  gap: 14px;
}
.work-swiper-pagination .swiper-pagination-bullet {
  width: 20px;
  height: 20px;
  margin: 0 !important;
  opacity: 1;
  background: rgba(216, 213, 47, 0.85);
  transition: background 0.3s ease, transform 0.3s ease;
}
.work-swiper-pagination .swiper-pagination-bullet-active {
  background: #ffffff;
  transform: scale(1.08);
}

/* Tablet */
@media (max-width: 991px) {
  .work-swiper-section {
    padding: 70px 0 95px;
  }
  .work-swiper .swiper-slide {
    width: 78vw;
  }
  .work-slide-card {
    height: 420px;
    border-radius: 36px;
  }
}
/* Mobile */
@media (max-width: 575px) {
  .work-swiper-section {
    padding: 55px 0 75px;
  }
  .work-swiper {
    padding-bottom: 70px;
  }
  .work-swiper .swiper-slide {
    width: 86vw;
    transform: scale(0.9);
  }
  .work-swiper .swiper-slide-active {
    transform: scale(1);
  }
  .work-slide-card {
    height: 280px;
    border-radius: 24px;
  }
  .work-swiper-controls {
    gap: 18px;
  }
  .work-swiper-prev,
  .work-swiper-next {
    font-size: 36px;
  }
  .work-swiper-pagination {
    gap: 10px;
  }
  .work-swiper-pagination .swiper-pagination-bullet {
    width: 13px;
    height: 13px;
  }
}/*# sourceMappingURL=teaching.css.map */
