/* ==========================================================================
   Selected work section
   ========================================================================== */
.selected-work-section {
  position: relative;
  width: 100%;
  min-height: 100vh;
  margin: 0;
  padding: 0 !important;
  overflow: visible !important;
  color: #ffffff;
}
.selected-work-section .green-bg {
  background-image: url("/images/green-bg.png");
  background-repeat: no-repeat;
  background-position: center;
  background-size: cover;
}
.selected-work-section .container {
  position: relative;
  z-index: 2;
  width: 90%;
  max-width: 1800px;
  margin: 0 auto;
}

/* ==========================================================================
   Common placeholder
   ========================================================================== */
.placeholder {
  overflow: hidden;
  border-radius: clamp(14px, 1.2vw, 22px);
  background: #666666;
}

/* ==========================================================================
   Optional selected-work intro
   ========================================================================== */
.selected-work-intro {
  display: grid;
  grid-template-columns: 1.08fr 0.92fr;
  gap: clamp(44px, 5vw, 82px);
  margin-bottom: 0 !important;
  padding: clamp(60px, 6vw, 100px) clamp(24px, 8vw, 150px);
  align-items: start;
}
.selected-work-intro .work-image {
  width: 100%;
  height: clamp(390px, 42vw, 620px);
}
.selected-work-intro.green-bg {
  background-color: #a5dd73;
  background-image: url("/images/body-bg.svg"), linear-gradient(90deg, rgb(165, 221, 115) 0%, rgb(89, 119, 62) 54%);
  background-repeat: no-repeat;
  background-position: left center, center;
  background-size: cover;
}

.intro-content {
  padding-top: clamp(6px, 1vw, 18px);
}
.intro-content h2 {
  margin: 0 0 clamp(16px, 1.5vw, 24px);
  color: #ffffff;
  font-size: clamp(31px, 3vw, 48px);
  font-weight: 800;
  line-height: 1.1;
}
.intro-content h2 .subheading {
  color: #eee7aa;
  font-weight: 400;
}
.intro-content h2::after {
  background: #eee7aa;
}
.intro-content h3 {
  margin: 0 0 clamp(32px, 3vw, 50px);
  color: #ffffff;
  font-family: "Neue Montreal Regular";
  font-size: clamp(20px, 1.8vw, 30px);
  font-weight: 400;
  line-height: 1.25;
}
.intro-content p {
  margin: 0;
  color: rgba(255, 255, 255, 0.92);
  font-size: clamp(15px, 1vw, 18px);
  line-height: 1.75;
}
.intro-content p:not(:last-child) {
  margin-bottom: clamp(24px, 2.4vw, 42px);
}

/* ==========================================================================
   Case row
   ========================================================================== */
.case-list {
  position: relative;
  width: 100%;
}

.case-row {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: clamp(48px, 6vw, 110px);
  padding: clamp(60px, 6vw, 100px) clamp(24px, 8vw, 150px);
  align-items: center;
}
.case-row.text-right {
  grid-template-columns: 1.1fr 0.9fr;
}
.case-row.text-right .case-image {
  order: 1;
}
.case-row.text-right .case-content {
  order: 2;
}
.case-row.text-left .case-content {
  order: 1;
}
.case-row.text-left .case-image {
  order: 2;
}
.case-row.green-bg {
  background-repeat: no-repeat;
  background-position: left center, center;
  background-size: cover;
  background-blend-mode: normal;
}
.case-row.green-bg.even {
  background-color: #59773e;
  background-image: url("/images/body-bg.svg"), linear-gradient(90deg, rgb(89, 119, 62) 50%, rgb(165, 221, 115) 100%);
}
.case-row.green-bg.odd {
  background-color: #a5dd73;
  background-image: url("/images/body-bg.svg"), linear-gradient(90deg, rgb(165, 221, 115) 0%, rgb(89, 119, 62) 54%);
}
.case-row.green-bg.odd .case-content h2::after {
  right: 0;
  left: auto;
  transform-origin: right;
}

/* ==========================================================================
   Case content
   ========================================================================== */
.case-content {
  display: flex;
  min-width: 0;
  flex-direction: column;
}
.case-content .case-header {
  display: flex;
  width: 100%;
  flex: 0 0 auto;
  flex-direction: column;
  align-items: flex-start;
}
.case-content .case-number {
  display: inline-flex;
  margin-bottom: 14px;
  padding: 7px 15px;
  border-radius: 30px;
  background: rgba(238, 231, 170, 0.16);
  color: #eee7aa;
  font-size: clamp(12px, 0.8vw, 14px);
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.case-content h2 {
  position: relative;
  display: block;
  width: 100%;
  margin: 0 0 clamp(22px, 2vw, 34px);
  color: #ffffff;
  font-size: clamp(28px, 2.6vw, 44px);
  font-weight: 800;
  line-height: 1.1;
  overflow-wrap: anywhere;
}
.case-content h2 .subheading {
  display: block;
  width: 100%;
  color: #eee7aa;
  font-weight: 400;
  line-height: inherit;
}
.case-content h2::after {
  display: block;
  width: min(100%, 520px);
  height: 2px;
  margin-top: 18px;
  background: #eee7aa;
  content: "";
  transform-origin: left;
}
.case-content h3 {
  position: relative;
  display: inline-block;
  margin: 0 0 clamp(28px, 2.5vw, 42px);
  color: #ffffff;
  font-family: "Neue Montreal Regular";
  font-size: clamp(20px, 1.75vw, 29px);
  font-weight: 400;
  line-height: 1.25;
}
.case-content h3::after {
  display: block;
  width: 100%;
  height: 1.5px;
  margin-top: clamp(8px, 0.8vw, 12px);
  background: rgba(255, 255, 255, 0.85);
  content: "";
}
.case-content p {
  margin: 0;
  color: rgba(255, 255, 255, 0.92);
  /* font-size: clamp(14px, 1vw, 17px); */
  line-height: 1.75;
}
.case-content p:not(:last-child) {
  margin-bottom: clamp(22px, 2vw, 36px);
}

.case-row.text-right .case-header {
  align-items: flex-end;
}
.case-row.text-right .case-number {
  align-self: flex-end;
  margin-left: auto;
}

.case-row.text-left .case-header {
  align-items: flex-start;
}
.case-row.text-left .case-number {
  align-self: flex-start;
  margin-right: auto;
}

/* ==========================================================================
   Case image
   ========================================================================== */
.case-image {
  width: 100%;
  height: clamp(360px, 39vw, 580px);
  min-width: 0;
  overflow: hidden;
  border-radius: 20px;
  background: rgba(33, 50, 27, 0.35);
}
.case-image img {
  display: block;
  width: 100%;
  height: 100%;
  -o-object-fit: cover;
     object-fit: cover;
  -o-object-position: center;
     object-position: center;
}

/* ==========================================================================
   GSAP stacked case animation
   ========================================================================== */
.case-pin-section {
  position: relative;
  width: 100%;
  margin: 0;
  padding: 0;
  overflow: visible !important;
  background-color: #59773e;
  background-image: url("/images/body-bg.svg"), linear-gradient(90deg, #59773e 0%, #a5dd73 100%);
  background-repeat: repeat, no-repeat;
  background-position: center;
  background-size: cover;
}

/*
 * ScrollTrigger adds a pin-spacer wrapper.
 * The background prevents blank white space while scrolling.
 */
.case-pin-section > .pin-spacer,
.case-pin-section .pin-spacer {
  background-color: #59773e !important;
  background-image: url("/images/body-bg.svg"), linear-gradient(90deg, #59773e 0%, #a5dd73 100%) !important;
  background-repeat: repeat, no-repeat !important;
  background-position: center !important;
  background-size: cover !important;
}

.case-pin-stage {
  position: relative;
  width: 100%;
  height: 100vh;
  height: 100dvh;
  min-height: 690px;
  margin: 0;
  padding: 0;
  overflow: hidden;
  isolation: isolate;
  perspective: 1400px;
  background: inherit;
}

.gsap-case-card {
  height: 100%;
  margin: 0 !important;
  overflow: hidden;
  border-radius: clamp(24px, 2vw, 38px) clamp(24px, 2vw, 38px) 0 0;
  box-shadow: 0 -18px 50px rgba(24, 39, 18, 0.24);
  transform-origin: 50% 0%;
  will-change: transform, filter;
  backface-visibility: hidden;
}
.gsap-case-card .case-content,
.gsap-case-card .case-image {
  min-width: 0;
  min-height: 0;
}
.gsap-case-card .case-content {
  height: auto;
  max-height: min(64vh, 100dvh - 210px);
  overflow: hidden;
}
.gsap-case-card .case-description {
  min-height: 0;
  padding-right: 18px;
  flex: 1 1 auto;
  overflow-x: hidden;
  overflow-y: scroll;
  overscroll-behavior: contain;
  scrollbar-gutter: stable;
  scrollbar-width: thin;
  scrollbar-color: #eee7aa rgba(255, 255, 255, 0.12);
}
.gsap-case-card .case-description:focus-visible {
  outline: 2px solid #eee7aa;
  outline-offset: -2px;
}
.gsap-case-card .case-description::-webkit-scrollbar {
  width: 7px;
}
.gsap-case-card .case-description::-webkit-scrollbar-track {
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.12);
}
.gsap-case-card .case-description::-webkit-scrollbar-thumb {
  border-radius: 20px;
  background: #eee7aa;
}
@media (min-width: 992px) {
  /* Keep each scrollbar beside its image in the alternating desktop layout. */
  .gsap-case-card.text-right .case-description {
    padding-right: 0;
    padding-left: 18px;
    direction: rtl;
  }

  .gsap-case-card.text-right .case-description > * {
    direction: ltr;
  }
}
.gsap-case-card .case-image {
  height: clamp(430px, 65vh, 680px);
  max-height: calc(100% - 70px);
  align-self: center;
}
.gsap-case-card .case-study-image {
  transform: scale(1.001);
  transition: transform 0.8s ease;
}
.gsap-case-card:hover .case-study-image {
  transform: scale(1.035);
}

/* ==========================================================================
   Protect the following section
   ========================================================================== */
.after-case-animation {
  position: relative;
  z-index: 5;
  margin-top: 0 !important;
  opacity: 1 !important;
  visibility: visible !important;
  transform: none !important;
  filter: none !important;
}
.after-case-animation > *,
.after-case-animation .container {
  opacity: 1 !important;
  visibility: visible !important;
}

/* ==========================================================================
   Approach across cases
   ========================================================================== */
.approach-cases-section {
  position: relative;
  width: 100%;
  padding: clamp(80px, 7vw, 135px) 0 clamp(100px, 9vw, 160px);
  overflow: hidden;
  color: #485a2e;
  background-color: #f1ef9d;
  background-image: url("/images/yellow-bg.webp") !important;
  background-repeat: no-repeat !important;
  background-position: center;
  background-size: cover !important;
}
.approach-cases-section .container {
  position: relative;
  z-index: 2;
  width: 90%;
  max-width: 1800px;
  margin: 0 auto;
}

/* ==========================================================================
   Approach heading
   ========================================================================== */
.approach-heading {
  margin-bottom: clamp(70px, 6vw, 110px);
}
.approach-heading h2 {
  position: relative;
  display: inline-block;
  margin: 0 0 22px;
  color: #485a2e;
  font-weight: 800;
  line-height: 1.1;
}
.approach-heading h2::after {
  display: block;
  width: 100%;
  min-width: 440px;
  height: 2px;
  margin-top: 12px;
  background: #485a2e;
  content: "";
}
.approach-heading p {
  max-width: 1200px;
  margin: 0;
  color: #485a2e;
  font-size: clamp(22px, 2.1vw, 34px);
  line-height: 1.35;
}

/* ==========================================================================
   Approach flow
   ========================================================================== */
.approach-flow-stage {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: clamp(14px, 1.4vw, 26px);
  margin-bottom: clamp(85px, 8vw, 140px);
  width: 100%;
}

.flow-line {
  fill: none;
  stroke: #485a2e;
  stroke-width: 4;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-dasharray: 900;
  stroke-dashoffset: 900;
  animation: drawLine 1.1s ease forwards;
}

.line-1 {
  animation-delay: 0.1s;
}

.line-2 {
  animation-delay: 0.35s;
}

.line-3 {
  animation-delay: 0.6s;
}

.line-4 {
  animation-delay: 0.9s;
}

.line-5 {
  animation-delay: 1.15s;
}

.flow-dot {
  fill: #485a2e;
  opacity: 0;
  transform: scale(0.4);
  transform-box: fill-box;
  transform-origin: center;
  animation: dotAppear 0.45s ease forwards, dotPulse 2.4s ease-in-out infinite;
}

.dot-1 {
  animation-delay: 0s, 1.4s;
}

.dot-2 {
  animation-delay: 0.45s, 1.6s;
}

.dot-3 {
  animation-delay: 0.75s, 1.8s;
}

.dot-4 {
  animation-delay: 1s, 2s;
}

.dot-5 {
  animation-delay: 1.3s, 2.2s;
}

.approach-label {
  position: relative;
  display: flex;
  min-height: clamp(170px, 14vw, 235px);
  padding: clamp(22px, 2vw, 34px);
  flex-direction: column;
  justify-content: space-between;
  gap: 30px;
  border: 1px solid #485a2e;
  border-radius: clamp(16px, 1.4vw, 24px);
  background: rgba(255, 255, 255, 0.32);
  box-shadow: 0 16px 36px rgba(72, 90, 46, 0.08);
  color: #485a2e;
  font-family: "Neue Montreal Regular";
  font-size: clamp(18px, 1.45vw, 27px);
  font-weight: 400;
  line-height: 1.3;
  letter-spacing: -0.02em;
  white-space: normal;
}
.approach-label > span {
  color: #485a2e;
}
.approach-label::after {
  position: absolute;
  top: 50%;
  right: calc(clamp(14px, 1.4vw, 26px) * -1);
  width: clamp(14px, 1.4vw, 26px);
  height: 1px;
  background: #485a2e;
  content: "";
}
.approach-label:last-child::after {
  display: none;
}
.approach-step-number {
  color: #485a2e;
  font-family: "Agrandir TextBold";
  font-size: clamp(14px, 1vw, 18px);
  letter-spacing: 0.08em;
}

/* ==========================================================================
   Approach closing
   ========================================================================== */
.approach-closing {
  max-width: 1280px;
}
.approach-closing h2 {
  position: relative;
  display: inline-block;
  margin: 0 0 clamp(24px, 2vw, 34px);
  color: #485a2e;
  font-size: clamp(30px, 3vw, 46px);
  font-weight: 800;
  line-height: 1.1;
}
.approach-closing h2::after {
  display: block;
  width: 100%;
  min-width: 135px;
  height: 2px;
  margin-top: 12px;
  background: #485a2e;
  content: "";
}
.approach-closing p {
  max-width: 1250px;
  margin: 0;
  color: #485a2e;
  font-size: clamp(20px, 1.8vw, 30px);
  line-height: 1.55;
}
.approach-closing p:not(:last-child) {
  margin-bottom: 12px;
}

/* ==========================================================================
   Approach animations
   ========================================================================== */
@keyframes drawLine {
  from {
    stroke-dashoffset: 900;
  }
  to {
    stroke-dashoffset: 0;
  }
}
@keyframes dotAppear {
  from {
    opacity: 0;
    transform: scale(0.4);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}
@keyframes dotPulse {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.78;
    transform: scale(1.18);
  }
}
@keyframes mobileLineGrow {
  from {
    transform: scaleY(0);
  }
  to {
    transform: scaleY(1);
  }
}
/* ==========================================================================
   Smaller desktop
   ========================================================================== */
@media (max-width: 1200px) and (min-width: 992px) {
  .case-row {
    gap: clamp(34px, 4vw, 58px);
    padding-right: clamp(35px, 5vw, 70px);
    padding-left: clamp(35px, 5vw, 70px);
  }
  .case-content p {
    /* font-size: 14px; */
    line-height: 1.62;
  }
}
/* ==========================================================================
   Tablet
   ========================================================================== */
@media (max-width: 991px) {
  .selected-work-section {
    min-height: auto;
    overflow: hidden !important;
  }
  .selected-work-section .container {
    width: 90%;
  }
  .selected-work-intro {
    grid-template-columns: 1fr;
    gap: 40px;
    margin-bottom: 90px;
  }
  .selected-work-intro .work-image {
    height: 420px;
  }
  .intro-content {
    max-width: 720px;
  }
  .case-pin-section {
    padding: 50px 0 80px;
    overflow: hidden !important;
  }
  .case-pin-stage {
    display: flex;
    height: auto;
    min-height: 0;
    flex-direction: column;
    gap: 30px;
    overflow: visible;
    perspective: none;
  }
  .gsap-case-card,
  .gsap-case-card.text-right,
  .gsap-case-card.text-left {
    position: relative !important;
    inset: auto !important;
    display: grid;
    width: calc(100% - 40px) !important;
    height: auto !important;
    margin: 0 auto !important;
    padding: clamp(38px, 6vw, 65px) clamp(25px, 6vw, 60px);
    grid-template-columns: 1fr;
    gap: 38px;
    border-radius: 24px;
    opacity: 1;
    visibility: visible;
    transform: none;
    filter: none;
  }
  .gsap-case-card .case-content,
  .gsap-case-card.text-right .case-content,
  .gsap-case-card.text-left .case-content {
    order: 1 !important;
    max-width: 720px;
    height: auto;
    max-height: none;
    padding-right: 0;
    overflow: visible;
  }
  .gsap-case-card .case-description,
  .gsap-case-card.text-right .case-description,
  .gsap-case-card.text-left .case-description {
    padding-right: 0;
    overflow: visible;
  }
  .gsap-case-card .case-image,
  .gsap-case-card.text-right .case-image,
  .gsap-case-card.text-left .case-image {
    order: 2 !important;
    width: 100%;
    height: 420px;
    max-height: none;
  }
  .approach-cases-section {
    padding: 70px 0 95px;
  }
  .approach-cases-section .container {
    width: 90%;
  }
  .approach-heading {
    margin-bottom: 55px;
  }
  .approach-heading h2::after {
    min-width: 100%;
  }
  .approach-flow-stage {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-bottom: 75px;
    gap: 20px;
  }
  .approach-svg {
    display: none;
  }
  .approach-label {
    position: relative;
    min-height: 180px;
    padding: 26px;
    font-size: 23px;
    line-height: 1.35;
    white-space: normal;
  }
  .approach-label::before {
    display: none;
  }
  .approach-label::after {
    display: none;
  }
  .approach-closing p {
    font-size: 23px;
  }
}
/* ==========================================================================
   Mobile
   ========================================================================== */
@media (max-width: 575px) {
  .selected-work-intro {
    gap: 34px;
    margin-bottom: 70px;
  }
  .selected-work-intro .work-image {
    height: 320px;
  }
  .intro-content h2 {
    font-size: 31px;
  }
  .intro-content h3 {
    margin-bottom: 28px;
    font-size: 20px;
  }
  .intro-content p {
    font-size: 15px;
    line-height: 1.7;
  }
  .intro-content p:not(:last-child) {
    margin-bottom: 24px;
  }
  .case-pin-section {
    padding: 35px 0 55px;
  }
  .case-pin-stage {
    gap: 22px;
  }
  .gsap-case-card,
  .gsap-case-card.text-right,
  .gsap-case-card.text-left {
    width: calc(100% - 24px) !important;
    padding: 28px 20px;
    gap: 25px;
    border-radius: 18px;
  }
  .gsap-case-card .case-content h2,
  .gsap-case-card.text-right .case-content h2,
  .gsap-case-card.text-left .case-content h2 {
    margin-bottom: 20px;
    font-size: 29px;
  }
  .gsap-case-card .case-content h3,
  .gsap-case-card.text-right .case-content h3,
  .gsap-case-card.text-left .case-content h3 {
    margin-bottom: 28px;
    font-size: 20px;
  }
  .gsap-case-card .case-content p,
  .gsap-case-card.text-right .case-content p,
  .gsap-case-card.text-left .case-content p {
    font-size: 14.5px;
    line-height: 1.7;
  }
  .gsap-case-card .case-content p:not(:last-child),
  .gsap-case-card.text-right .case-content p:not(:last-child),
  .gsap-case-card.text-left .case-content p:not(:last-child) {
    margin-bottom: 24px;
  }
  .gsap-case-card .case-image,
  .gsap-case-card.text-right .case-image,
  .gsap-case-card.text-left .case-image {
    height: 300px;
    border-radius: 14px;
  }
  .approach-cases-section {
    padding: 55px 0 75px;
  }
  .approach-heading {
    margin-bottom: 45px;
  }
  .approach-heading h2 {
    font-size: 30px;
  }
  .approach-heading p {
    font-size: 20px;
  }
  .approach-flow-stage {
    grid-template-columns: 1fr;
    gap: 26px;
    margin-bottom: 60px;
  }
  .approach-label {
    min-height: 145px;
    font-size: 21px;
  }
  .approach-closing h2 {
    font-size: 30px;
  }
  .approach-closing p {
    font-size: 19px;
    line-height: 1.55;
  }
}
/* ==========================================================================
   Reduced motion
   ========================================================================== */
@media (prefers-reduced-motion: reduce) {
  .case-pin-stage {
    display: flex;
    height: auto !important;
    min-height: 0 !important;
    padding: 40px 0;
    flex-direction: column;
    gap: 30px;
    overflow: visible !important;
  }
  .gsap-case-card {
    position: relative !important;
    inset: auto !important;
    width: calc(100% - 40px) !important;
    height: auto !important;
    margin: 0 auto !important;
