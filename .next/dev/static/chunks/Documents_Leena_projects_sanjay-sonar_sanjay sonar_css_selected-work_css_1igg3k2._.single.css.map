    visibility: visible !important;
    transform: none !important;
    filter: none !important;
  }
  .gsap-case-card .case-content {
    height: auto;
    max-height: none;
    overflow: visible;
  }
  .gsap-case-card .case-study-image {
    transition: none;
  }
  .flow-line,
