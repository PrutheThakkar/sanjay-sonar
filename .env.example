WORDPRESS_GRAPHQL_URL=https://drsanjay-wp.studiosentientdemo.com/graphql

# Canonical production origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://sanjaysonar.com

# Google Analytics 4 measurement ID. Analytics stays disabled when omitted.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional token from Google Search Console's HTML-tag verification method.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-token

# Production webhook URL from your n8n Webhook node. Keep this server-side.
N8N_WEBHOOK_URL=https://pruthe.app.n8n.cloud/webhook/a294fd41-d8f6-497f-bf5b-9de5d4401834


# Current setup: child Pages beneath a parent Page whose slug is "expertise".
WORDPRESS_EXPERTISE_GRAPHQL_COLLECTION=pages
WORDPRESS_EXPERTISE_GRAPHQL_SINGLE=page
WORDPRESS_EXPERTISE_PARENT_SLUG=expertise

